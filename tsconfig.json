{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@assets/*": ["./assets/*",],
      "@views/*": ["./src/views/*",],
      "@transitions/*": ["./src/transitions/*",],
      "@style/*": ["./src/style/*",],
      "@utils/*": ["./src/core/utils/*",]
    }
  }
}
